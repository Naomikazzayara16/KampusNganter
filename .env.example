# Salin ke .env.local lalu isi. Jangan pernah commit file .env apa pun.
# Semua variabel ini hanya dibaca di server; tidak ada yang dikirim ke browser.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Kunci rahasia (service role). Simpan hanya di environment variable hosting.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Minimal 32 karakter acak, mis. hasil: openssl rand -hex 32
OTP_HASH_SECRET=

# URL gambar QRIS usaha (opsional). Contoh: https://domainmu.id/qris.png
QRIS_IMAGE_URL=
